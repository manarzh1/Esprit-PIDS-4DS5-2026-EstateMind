# ══════════════════════════════════════════════════════════════
# Estate Mind — Variables d'environnement
# ══════════════════════════════════════════════════════════════
# INSTRUCTIONS :
#   1. Copiez ce fichier en .env :  cp .env.example .env
#   2. Remplissez les valeurs réelles (ne commitez jamais .env)
#   3. Pour Supabase → Settings → Database → Connection string (URI)
# ══════════════════════════════════════════════════════════════

# ── LLM (OpenAI) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-VOTRE_CLE_ICI
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
NLP_TEMPERATURE=0.0
NLP_BATCH_SIZE=20

# ── Supabase (Base de données principale) ─────────────────────
# Trouvez ces valeurs dans : Supabase → Settings → Database
#
# DATABASE_URL : Settings → Database → Connection string → URI mode
# Format : postgresql://postgres:[MOT_DE_PASSE]@db.[ID_PROJET].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# SUPABASE_URL : Settings → API → Project URL
# Format : https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SUPABASE_ANON_KEY : Settings → API → anon public key
# (clé publique, pas la service_role key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Pipeline ──────────────────────────────────────────────────
MAX_PAGES_PER_SOURCE=10
PIPELINE_SCHEDULE_HOURS=6
TRUST_SCORE_THRESHOLD=0.50
PRICE_OUTLIER_FACTOR=3.0
DEDUP_THRESHOLD=0.95
MIN_SURFACE=5
MAX_SURFACE=5000
MIN_PRICE=1000
MAX_PRICE=10000000

# ── MLflow (tracking des runs pipeline) ──────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=estate_mind_pipeline

# ── RAG / Vector Store (BO5 — non utilisé BO1+BO2) ───────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════
# NOTES D'INSTALLATION :
#
# 1. Installer les dépendances Python :
#    pip install -r requirements.txt --break-system-packages
#    pip install psycopg2-binary --break-system-packages
#
# 2. Tester la connexion Supabase :
#    python db/test_supabase.py
#
# 3. Créer les tables (si pas encore fait via SQL Editor) :
#    python -c "from db.supabase_manager import get_db; get_db().ensure_tables()"
#
# 4. Lancer le backend :
#    uvicorn main_api:app --reload --port 8000
# ══════════════════════════════════════════════════════════════
